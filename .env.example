# Configuration Firebase Realtime Database pour Le Bus Quizz
# Copiez ce fichier vers .env ou définissez ces variables dans votre hébergeur (Lovable Cloud / Vercel / Netlify)

VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=lina-cosmetiques-quiz.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://lina-cosmetiques-quiz-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=lina-cosmetiques-quiz
VITE_FIREBASE_STORAGE_BUCKET=lina-cosmetiques-quiz.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
